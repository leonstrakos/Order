<!DOCTYPE html><html lang="en"><head>
  <title>Application form</title>
  
  <%- include("partials/metadata") %>
<link rel="stylesheet" href="/css/form.css">
</head> <body>
</head>
<body>



  <main class="page">
   <!-- <h1 class="page-title"></h1>
    <p class="page-subtitle"> </p>-->



      <article id="form" class="theme-card parchment">
        <section class="form-wrap">

                <!--svg-->
            <span class="bell-icon"><svg viewBox="0 0 100 100" width="18" height="18" fill="currentColor"><!-- bell --> <path d="M50 15 C40 15 35 25 35 35 L35 55C35 60 30 65 30 65L70 65  C70 65 65 60 65 55L65 35  C65 25 60 15 50 15Z" />
            <!-- clapper -->  <circle cx="50" cy="72" r="4"/><!-- rays --><line x1="50" y1="5" x2="50" y2="12" stroke="currentColor" stroke-width="2"/> <line x1="20" y1="30" x2="28" y2="34" stroke="currentColor" stroke-width="2"/> <line x1="80" y1="30" x2="72" y2="34" stroke="currentColor" stroke-width="2"/></svg></span>




            <!--  <span class="dropcap">J</span>-->
                
                
                            <div class="ornate-heading">
            <span class="dropcap-box">B</span>
            <div class="heading-text">
                <h2>ell's <br>application</h2>
                <p class="intro">
                </p>
            </div>
            </div>





            <form class="application-form" action="/register" method="post">

  <input
    type="hidden"
    name="next"
    value="<%= typeof next !== 'undefined' ? next : '/app/' %>"
  >

  <% if (typeof error !== "undefined" && error) { %>
    <div class="seal form-status"><%= error %></div>
  <% } %>

  <div class="field">
    <label for="p-name">
      <span class="label-initial">N</span>ame
    </label>
    <input
      id="p-name"
      name="displayName"
      type="text"
      autocomplete="name"
      maxlength="160"
      value="<%= typeof values !== 'undefined' ? values.displayName || '' : '' %>"
      required
    >
  </div>

  <div class="field">
    <label for="p-username">
      <span class="label-initial">U</span>sername
    </label>
    <input
      id="p-username"
      name="username"
      type="text"
      autocomplete="username"
      minlength="3"
      maxlength="80"
      pattern="[A-Za-z0-9._-]+"
      value="<%= typeof values !== 'undefined' ? values.username || '' : '' %>"
      required
    >
  </div>

  <div class="field">
    <label for="p-email">
      <span class="label-initial">E</span>mail address
    </label>
    <input
      id="p-email"
      name="email"
      type="email"
      autocomplete="email"
      maxlength="254"
      value="<%= typeof values !== 'undefined' ? values.email || '' : '' %>"
      required
    >
  </div>

  <div class="field">
    <label for="p-country">
      <span class="label-initial">C</span>ountry code
      <small> — optional</small>
    </label>
    <input
      id="p-country"
      name="countryCode"
      type="text"
      maxlength="8"
      placeholder="HR"
      value="<%= typeof values !== 'undefined' ? values.countryCode || '' : '' %>"
    >
  </div>

  <div class="field">
    <label for="p-password">
      <span class="label-initial">P</span>assword
      <small> — 12+ characters</small>
    </label>
    <input
      id="p-password"
      name="password"
      type="password"
      autocomplete="new-password"
      minlength="12"
      required
    >
  </div>

  <div class="field">
    <label for="p-password-confirm">
      <span class="label-initial">C</span>onfirm password
    </label>
    <input
      id="p-password-confirm"
      name="passwordConfirm"
      type="password"
      autocomplete="new-password"
      minlength="12"
      required
    >
  </div>

  <div class="field">
    <label for="p-reason">
      <span class="label-initial">W</span>hat brings you to the Order?
    </label>
    <textarea
      id="p-reason"
      name="applicationStatement"
      placeholder="A few words are enough..."
    ></textarea>
  </div>

  <div class="field">
    <label for="p-areas">
      <span class="label-initial">A</span>reas of interest or study
    </label>
    <textarea
      id="p-areas"
      name="areas"
      placeholder="Research, philosophy, history, consciousness, anomalous phenomena, art..."
    ></textarea>
  </div>

  <button type="submit">Create Seeker Identity</button>

  <div class="seal">
    Registration establishes a Seeker record. It is not initiation or advancement.
    <br><br>
    Already registered? <a href="/login">Sign in.</a>
  </div>

</form>
        </section>
      </article>
</main>
</body>
</html>