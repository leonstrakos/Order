<!DOCTYPE html><html lang="en"><head>
  <title>Application form</title>
  
  <%- include("partials/metadata") %>
<link rel="stylesheet" href="/css/form.css">
</head> <body>
</head>
<body>



  <main class="page">
   <!-- <h1 class="page-title"></h1>
    <p class="page-subtitle"> </p>-->



      <article id="form" class="theme-card parchment">
        <section class="form-wrap">

                <!--svg-->
            <span class="bell-icon"><svg viewBox="0 0 100 100" width="18" height="18" fill="currentColor"><!-- bell --> <path d="M50 15 C40 15 35 25 35 35 L35 55C35 60 30 65 30 65L70 65  C70 65 65 60 65 55L65 35  C65 25 60 15 50 15Z" />
            <!-- clapper -->  <circle cx="50" cy="72" r="4"/><!-- rays --><line x1="50" y1="5" x2="50" y2="12" stroke="currentColor" stroke-width="2"/> <line x1="20" y1="30" x2="28" y2="34" stroke="currentColor" stroke-width="2"/> <line x1="80" y1="30" x2="72" y2="34" stroke="currentColor" stroke-width="2"/></svg></span>




            <!--  <span class="dropcap">J</span>-->
                
                
                            <div class="ornate-heading">
            <span class="dropcap-box">B</span>
            <div class="heading-text">
                <h2>ell's <br>application</h2>
                <p class="intro">
                </p>
            </div>
            </div>







          
        <form class="application-form" action="/form" method="post">
            <div class="field">

<label for="p-day"><span class="label-initial">D</span>escribe your day</label>
              <textarea id="p-day" name="day" placeholder="Tell us how your day unfolds upon the turning wheel of hours..."></textarea>
            </div>


            <div class="field">
<label for="p-life"><span class="label-initial">D</span>escribe your life</label>
              <textarea id="p-life" name="life" placeholder="Write of your path, your nature, and your ambitions..."></textarea>
            </div>

                <div class="field">
<label for="p-gain"><span class="label-initial">W</span>hat do you seek to gain?</label>
              <textarea id="p-gain" name="gain" placeholder="Write of your path, your nature, and your ambitions..."></textarea>
            </div>

                <div class="field">
<label for="p-give"><span class="label-initial">W</span>hat are you willing to give up?</label>
              <textarea id="p-give" name="give" placeholder="Write of your path, your nature, and your ambitions..."></textarea>
            </div>
    
            <div class="field">
<label for="p-email"><span class="label-initial">E</span>mail address</label>
              <input id="p-email" name="email" type="email" placeholder="yourname@example.com" />
            </div>
            <button type="submit">Submit Application</button>
            <div class="seal">By submitting, you seek entry into the Order.</div>
          </form>

        </section>
      </article>


  </main>






  <script>
    const forms = document.querySelectorAll('.application-form');

    forms.forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const button = form.querySelector('button');
        const existingStatus = form.querySelector('.form-status');
        if (existingStatus) existingStatus.remove();

        const data = {
          day: form.querySelector('textarea[name="day"]').value,
          life: form.querySelector('textarea[name="life"]').value,
          give: form.querySelector('textarea[name="give"]').value,
          gain: form.querySelector('textarea[name="gain"]').value,
          email: form.querySelector('input[name="email"]').value,
        };

        const status = document.createElement('div');
        status.className = 'form-status seal';
        status.textContent = 'Sending your petition...';
        form.appendChild(status);

        button.disabled = true;
        button.style.opacity = '0.7';
        button.style.cursor = 'wait';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.message || 'The ritual failed.');
          }

          status.textContent = result.message || 'Your petition has been delivered.';
          form.reset();
        } catch (error) {
          status.textContent = error.message || 'Something went wrong while sending the form.';
        } finally {
          button.disabled = false;
          button.style.opacity = '1';
          button.style.cursor = 'pointer';
        }
      });
    });
  </script>
</body>

</html>
