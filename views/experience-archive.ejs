<!DOCTYPE html><html lang="en"><head><title>Experience Archive | The Archive</title><%- include("partials/metadata") %><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/archive-v2.css"></head><body><%- include("partials/header") %>
<main class="archive-page listing-page"><section class="archive-hero compact"><p class="archive-kicker">THE ARCHIVE · III</p><h1>EXPERIENCE ARCHIVE</h1><p class="archive-intro">Only reviewed records whose contributors consented to public preservation appear here. Witness interpretation is never presented as established fact.</p><a class="archive-action" href="/report">SUBMIT AN EXPERIENCE</a></section>
<section class="library-grid"><% if (experiences.length) { experiences.forEach(item => { %><article class="library-record"><p class="code"><%= item.experience_code %> · <%= item.review_status %></p><h2><%= item.location || item.country || 'Location withheld' %></h2><p class="author"><%= item.date_of_experience || 'Date not specified' %><%= item.state_of_consciousness ? ` · ${item.state_of_consciousness}` : '' %></p><p class="excerpt"><%= item.raw_narrative.length > 360 ? item.raw_narrative.slice(0,360) + '…' : item.raw_narrative %></p><% if (item.witness_interpretation) { %><p class="meta">WITNESS INTERPRETATION · <%= item.witness_interpretation %></p><% } %></article><% }) } else { %><p class="empty-record">No reviewed public experience records have yet been released.</p><% } %></section></main></body></html>
