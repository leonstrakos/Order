<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= member.displayName %> · Herald Record</title>
  <%- include("partials/metadata") %>
  <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
  <div class="profile-bg"></div>
  <main class="page">
    <nav>
      <a href="/archive">ARCHIVE</a>
      <a href="/bell">THE BELL</a>
      <a href="/hrs/open">OPEN HRS</a>
      <a href="/logout">SIGN OUT</a>
    </nav>

    <header>
      <img class="stamp" src="/images/lionsbell-stamp.png" alt="Order stamp">
      <p class="kicker">ORDER OF THE LION'S BELL · MEMBER RECORD</p>
      <h1><%= member.registryLabel || member.stageName || 'MEMBER' %></h1>
      <h2><%= member.displayName %></h2>
      <p class="latin">Campana Sonat Omnibus</p>
    </header>

    <section class="record">
      <div><span>PERMANENT CODE</span><strong><%= member.memberCode %></strong></div>
      <div><span>STAGE</span><strong><%= member.stageName || member.stageCode || '—' %></strong></div>
      <div><span>STANDING</span><strong><%= member.standing || '—' %></strong></div>
      <div><span>CHAPTER</span><strong><%= member.chapterName || member.chapterCode || '—' %></strong></div>
      <div><span>OFFICES</span><strong><%= (member.offices || []).join(' · ') || '—' %></strong></div>
      <div><span>CIRCLE</span><strong><%= member.circle || '—' %></strong></div>
    </section>

    <% if (String(member.stageCode || '').toUpperCase() === 'KEEPER_OF_BELL' || String(member.stageName || '').toLowerCase() === 'keeper of the bell') { %>
      <section class="archive-office">
        <p class="kicker">OFFICE OF THE ARCHIVE</p>
        <h3>ARCHIVE ADMINISTRATION</h3>
        <p>Import the canonical Heralds Research Library catalogue into the same HRS used by the app. The website does not maintain a second catalogue.</p>

        <% if (importError) { %>
          <div class="notice error"><%= importError %></div>
        <% } %>

        <% if (importResult) { %>
          <div class="notice ok"><strong>HRS RESPONSE</strong><pre><%= typeof importResult === 'string' ? importResult : JSON.stringify(importResult, null, 2) %></pre></div>
        <% } %>

        <form action="/profile/archive/import" method="POST" enctype="multipart/form-data">
          <label class="file">
            <span>HRL CATALOGUE · XLSX</span>
            <input type="file" name="catalogue" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required>
          </label>
          <button>IMPORT TO HRS <span>›</span></button>
        </form>
        <small>Keeper of the Bell only · Maximum file size: 15 MB.</small>
      </section>
    <% } %>

    <footer><img src="/images/lionsbell-stamp.png" alt=""><span>AUTHENTICATED THROUGH HRS</span></footer>
  </main>
</body>
</html>
