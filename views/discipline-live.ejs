<!DOCTYPE html><html lang="en"><head>
  <title><%= discipline.title %> | Order of the Lion's Bell</title>
  <%- include("partials/metadata") %>
  <%- include("partials/discipline-header") %>

  <main>
    <section class="hero">
      <h1><%= discipline.title %></h1>
      <p class="subtitle"><%= discipline.subtitle %></p>
      <% if (snapshot?.config?.hrs?.length) { %>
        <p class="discipline-linkage">HRS FIELDS · <%= snapshot.config.hrs.join(' · ') %></p>
      <% } %>
    </section>

    <section class="section" id="doctrine">
      <div class="accordion">
        <details class="panel-box" open>
          <summary><span class="glyph">I</span><h3>Fields of Inquiry</h3></summary>
          <div class="panel-content"><ul>
            <% discipline.fields.forEach(item => { %><li><%= item %></li><% }) %>
          </ul></div>
        </details>

        <details class="panel-box">
          <summary><span class="glyph">II</span><h3>Open Questions</h3></summary>
          <div class="panel-content"><ul>
            <% discipline.questions.forEach(item => { %><li><%= item %></li><% }) %>
            <% if (snapshot?.reports?.length) { snapshot.reports.forEach(report => { if (report.open_questions) { %>
              <li><strong><%= report.report_code %></strong> · <%= report.open_questions %></li>
            <% } }) } %>
          </ul></div>
        </details>

        <details class="panel-box">
          <summary><span class="glyph">III</span><h3>Research Frontiers</h3></summary>
          <div class="panel-content"><ul>
            <% discipline.frontiers.forEach(item => { %><li><%= item %></li><% }) %>
            <% if (snapshot?.reports?.length) { snapshot.reports.forEach(report => { if (report.research_question) { %>
              <li><strong><%= report.report_code %></strong> · <%= report.research_question %></li>
            <% } }) } %>
          </ul></div>
        </details>

        <details class="panel-box" id="archive">
          <summary><span class="glyph">IV</span><h3>Records of the Discipline</h3></summary>
          <div class="panel-content">
            <div class="records">
              <div class="record-block">
                <h4>Research Library</h4>
                <% if (snapshot?.sources?.length) { snapshot.sources.slice(0,5).forEach(source => { %>
                  <p><a class="record-link" href="/archive/library?q=<%= encodeURIComponent(source.hrl_id) %>"><%= source.hrl_id %> · <%= source.title %></a></p>
                <% }) } else { %><p>No sources are currently indexed here.</p><% } %>
              </div>
              <div class="record-block">
                <h4>HRS Research Index</h4>
                <p><%= snapshot?.stats?.claims || 0 %> claims · <%= snapshot?.stats?.cases || 0 %> case files · <%= snapshot?.stats?.investigations || 0 %> investigations linked to the corresponding HRS fields.</p>
                <p><small>Internal records are counted here but not automatically published.</small></p>
              </div>
              <div class="record-block">
                <h4>Bell Reports</h4>
                <% if (snapshot?.reports?.length) { snapshot.reports.slice(0,5).forEach(item => { %>
                  <p><a class="record-link" href="/bell"><%= item.report_code %> · <%= item.title %></a></p>
                <% }) } else { %><p>No published Bell Reports are currently indexed here.</p><% } %>
              </div>
              <div class="record-block">
                <h4>HRS Status</h4>
                <p><%= snapshot?.connected ? 'This page is reading the live bell research database.' : 'The live HRS bridge is not configured in this environment.' %></p>
              </div>
            </div>
          </div>
        </details>
      </div>
    </section>
  </main>
</div>
<style>
.discipline-linkage{margin-top:1.2rem;color:var(--gold);font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;opacity:.75}
.record-link{color:inherit;text-decoration:none;border-bottom:1px solid rgba(214,179,106,.25)}
.record-link:hover{color:var(--gold)}
.panel-content small{display:inline;color:var(--gold);font-family:Georgia,serif;font-size:.62rem;letter-spacing:.08em;margin-left:.4rem}
</style>
<%- include("partials/discipline-footer") %>
