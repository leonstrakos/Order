<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dossier Interface</title>

<style>
/* RESET */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* BACKGROUND */
body {
  background: #0a0a0a;
  font-family: "Courier New", monospace;
}

/* DOSSIER WRAP */
.dossier {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  padding: 40px 20px;
}

/* PAPER */
.paper {
  width: min(900px, 100%);
  background: #f3f1e8;
  color: #111;
  padding: 50px;
  position: relative;
  box-shadow:
    0 0 0 1px rgba(0,0,0,0.2),
    0 25px 60px rgba(0,0,0,0.6);
}

/* PAPER TEXTURE */
.paper::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(rgba(0,0,0,0.03) 1px, transparent 1px);
  background-size: 3px 3px;
  pointer-events: none;
}

/* STAMPS */
.stamp {
  position: absolute;
  border: 2px solid #b30000;
  color: #b30000;
  padding: 6px 12px;
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  opacity: 0.85;
}

.stamp-top {
  top: 20px;
  right: 20px;
}

.stamp-diag {
  top: 120px;
  left: 40px;
  transform: rotate(-18deg);
  font-size: 1.1rem;
}

/* HEADER */
.doc-title {
  font-size: 1.8rem;
  letter-spacing: 0.05em;
  margin-bottom: 10px;
}

.doc-meta {
  font-size: 0.85rem;
  line-height: 1.6;
  margin-bottom: 30px;
}

/* TABS */
.tabs {
  display: flex;
  gap: 6px;
  margin-bottom: 20px;
}

.tab {
  padding: 6px 14px;
  background: #ddd;
  border: 1px solid #aaa;
  font-size: 0.8rem;
  cursor: pointer;
}

.tab.active {
  background: #fff;
  border-bottom: 1px solid #fff;
}

/* CONTENT */
.content p {
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 14px;
}

/* REDACTION */
.redacted {
  display: inline-block;
  background: #111;
  height: 1em;
  width: 140px;
  vertical-align: middle;
}

.redacted.short {
  width: 60px;
}

/* BUTTON */
.btn {
  margin-top: 20px;
  display: inline-block;
  padding: 8px 14px;
  border: 1px solid #222;
  background: #eee;
  cursor: pointer;
  font-size: 0.8rem;
}

.btn:hover {
  background: #ddd;
}

/* SCANLINE EFFECT */
body::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(
    to bottom,
    rgba(255,255,255,0.02),
    rgba(255,255,255,0.02) 1px,
    transparent 1px,
    transparent 3px
  );
  opacity: 0.4;
}

/* TYPEWRITER EFFECT */
.typewriter {
  overflow: hidden;
  white-space: nowrap;
  border-right: 2px solid #111;
  width: 0;
  animation: typing 3s steps(30, end) forwards, blink 0.7s infinite;
}

@keyframes typing {
  to { width: 100% }
}

@keyframes blink {
  50% { border-color: transparent }
}

</style>
</head>

<body>

<div class="dossier">
  <div class="paper">

    <!-- STAMPS -->
    <div class="stamp stamp-top">TOP SECRET</div>
    <div class="stamp stamp-diag">EYES ONLY</div>

    <!-- HEADER -->
    <h1 class="doc-title typewriter">ARCHIVE FILE</h1>

    <p class="doc-meta">
      FILE ID: LB-0427-A<br>
      CLEARANCE: LEVEL IV<br>
      STATUS: RESTRICTED
    </p>

    <!-- TABS -->
    <div class="tabs">
      <div class="tab active">REPORTS</div>
      <div class="tab">HERALDS</div>
      <div class="tab">INDEX</div>
    </div>

    <!-- CONTENT -->
    <div class="content">
      <p>
        Bell Reports contain <span class="redacted"></span> observational records
        related to <span class="redacted short"></span> phenomena.
      </p>

      <p>
        Initial findings suggest correlation between subject activity and
        <span class="redacted"></span> patterns.
      </p>

      <p>
        Further investigation required. Access to full dataset remains
        <span class="redacted short"></span>.
      </p>

      <p>
        “From the archive, truth is <span class="redacted short"></span>.”
      </p>
    </div>

    <div class="btn">OPEN FILE</div>

  </div>
</div>

</body>
</html>