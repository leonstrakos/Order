<!DOCTYPE html><html lang="en"><head><title>Enter the Order</title><%- include("partials/metadata") %><link rel="stylesheet" href="/css/login.css"></head>
<body class="login-page"><main class="login-hero"><div class="login-bg"></div><section class="login-shell">
  <a class="seal-link" href="/"><img src="/images/lionsbell-stamp.png" alt="Order of the Lion's Bell"></a>
  <p class="kicker">HERALDS RESEARCH SYSTEM · ORDER ACCESS</p><h1>ENTER THE ORDER</h1><p class="motto">Campana Sonat Omnibus</p>
  <% if (error) { %><p class="login-error"><%= error %></p><% } %>
  <form class="login-form" action="/login" method="POST"><label>HRS IDENTITY<input type="text" name="identity" autocomplete="username" placeholder="Username" required></label><label>PASSWORD<input type="password" name="password" autocomplete="current-password" placeholder="••••••••" required></label><button type="submit">ENTER THE HALL <span>›</span></button></form>
  <div class="sigil-line"></div><p class="login-note">One identity for the Order and the Research System.</p>
</section></main></body></html>
