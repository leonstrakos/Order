<!DOCTYPE html>
<html lang="en">
<head>
  <title>Enter the Order</title>
  <%- include("partials/metadata") %>
  <link rel="stylesheet" href="/css/login.css">
</head>

<body class="login-page">

  <section class="login-hero">
    <div class="login-stars"></div>




    <div class="login-shell">
     
      <form class="login-form" action="/login" method="POST">
              <p class="motto">Campana Sonat Omnibus</p>
        <input type="text" name="identity" placeholder="Name or Email" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">Enter</button>
      </form>

      <p class="login-note">Access is reserved for those admitted.</p>
    </div>
  </section>

  <script src="/js/app.js"></script>
</body>
</html>