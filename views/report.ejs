<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Submit Bell Report</title>
  <link rel="stylesheet" href="/css/submit-report.css">

  <style>
    

:root{
  --paper:#f4f0e4;
  --ink:#111;
  --line:#cfc8b8;
  --red:#8d1f1f;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background:#0a0a0a;
  padding:50px 20px;
  font-family:"Courier New", monospace;
}

.paper{
  max-width:900px;
  margin:auto;
  background:var(--paper);
  color:var(--ink);
  padding:50px;
  position:relative;

  box-shadow:
    0 0 0 1px rgba(0,0,0,.15),
    0 20px 60px rgba(0,0,0,.5);
}

.paper::before{
  content:"";
  position:absolute;
  inset:0;

  background:
    radial-gradient(
      rgba(0,0,0,.03) 1px,
      transparent 1px
    );

  background-size:3px 3px;

  pointer-events:none;
}

.stamp{
  position:absolute;
  top:25px;
  right:25px;

  border:2px solid var(--red);
  color:var(--red);

  padding:8px 14px;

  transform:rotate(12deg);

  letter-spacing:.15em;
  font-size:.8rem;
}

.header{
  margin-bottom:40px;
}

.eyebrow{
  text-transform:uppercase;
  letter-spacing:.25em;
  font-size:.75rem;
  opacity:.7;
  margin-bottom:12px;
}

h1{
  font-size:2.5rem;
  margin-bottom:18px;
}

.intro{
  max-width:700px;
  line-height:1.7;
}

.section{
  margin-bottom:40px;
}

.section h2{
  font-size:1rem;
  text-transform:uppercase;
  letter-spacing:.15em;

  padding-bottom:8px;
  margin-bottom:18px;

  border-bottom:1px solid var(--line);
}

label{
  display:block;
  margin-bottom:8px;
  font-size:.85rem;
}

input,
textarea,
select{

  width:100%;
  padding:12px;

  margin-bottom:18px;

  border:1px solid var(--line);

  background:#fff;

  font-family:inherit;
}

textarea{
  resize:vertical;
}

.checks{
  display:grid;
  gap:10px;
}

.checks label{
  display:flex;
  gap:10px;
  align-items:center;
}

.checks input{
  width:auto;
  margin:0;
}

.small{
  margin-bottom:10px;
  opacity:.7;
  font-size:.85rem;
}

.submit-btn{

  width:100%;

  padding:16px;

  border:none;

  background:#111;
  color:white;

  cursor:pointer;

  letter-spacing:.2em;
  text-transform:uppercase;

  transition:.2s;
}

.submit-btn:hover{
  background:#222;
}

@media(max-width:700px){

  .paper{
    padding:30px 20px;
  }

  h1{
    font-size:1.8rem;
  }

}
  </style>
</head>
<body>

<div class="paper">

  <div class="stamp">UNREVIEWED</div>

  <header class="header">

    <p class="eyebrow">
      Bell Reports • Case Submission
    </p>

    <h1>SUBMIT A BELL REPORT</h1>

    <p class="intro">
      Reports are preserved for investigation, analysis, and future inquiry.
      Submission does not imply endorsement, validation, or conclusion.
    </p>

  </header>
<form
action="/reports/create"
method="POST"
enctype="multipart/form-data">

    <!-- CLASSIFICATION -->

    <section class="section">
      <h2>Classification</h2>

    <select name="category">
      <option>UFO / UAP</option>
      <option>Parapsychology</option>
      <option>Dreams & Precognition</option>
      <option>Folklore & High-Strangeness</option>
      <option>Religious / Mystical Experience</option>
      <option>Other Anomalous Experience</option>
    </select>

    <!-- TITLE -->
<input type="text" name="author" placeholder="Name or pseudonym">

<input type="email" name="email"
placeholder="Optional contact email">





    <section class="section">
      <h2>Demographic information</h2>


      <input type="text"
name="age"
placeholder="Age">


    <select name="sex">
      <option>Male</option>
      <option>Female</option>

    </select>

    <section class="section">
      <h2>About the Event</h2>

<input type="text"
name="title"
placeholder="Brief title">

<input type="date"
name="eventDate">

<input type="text"
name="location"
placeholder="Location">

<select name="witnesses">
  <option>Only Me</option>
  <option>2–5 Witnesses</option>
  <option>More than 5 Witnesses</option>
</select>
<textarea
name="report"
rows="12"
placeholder="Describe exactly what happened. Include times, observations, emotions, and anything unusual."
></textarea>

<input
type="file"
name="evidenceFiles"
multiple
accept="
image/*,
video/*,
audio/*,
application/pdf">
  

<label>Duration</label>

<select name="duration">
  <option>Less than 1 minute</option>
  <option>1–5 minutes</option>
  <option>5–30 minutes</option>
  <option>More than 30 minutes</option>
</select>

<label>Weather</label>

<select name="weather">
  <option>Clear</option>
  <option>Cloudy</option>
  <option>Rain</option>
  <option>Snow</option>
  <option>Unknown</option>
</select>

<label>Time of Day</label>

<select name="timeOfDay">
  <option>Morning</option>
  <option>Afternoon</option>
  <option>Evening</option>
  <option>Night</option>
</select>


<section class="section">
<h2>Effects Experienced</h2>

<div class="checks">

<label>
<input type="checkbox" name="effects" value="Fear">
Fear
</label>

<label>
<input type="checkbox" name="effects" value="Euphoria">
Euphoria
</label>

<label>
<input type="checkbox" name="effects" value="Missing Time">
Missing Time
</label>

<label>
<input type="checkbox" name="effects" value="Physical Sensation">
Physical Sensation
</label>

<label>
<input type="checkbox" name="effects" value="Dream Afterwards">
Dream Afterwards
</label>

<label>
<input type="checkbox" name="effects" value="Electrical Disturbance">
Electrical Disturbance
</label>

</div>
</section>

<textarea
name="additionalNotes"
rows="5"
placeholder="Any additional details, theories, or observations."
></textarea>


<section class="section">

<h2>Alternative Explanations Considered</h2>

<textarea
name="alternativeExplanations"
rows="6"
placeholder="Describe any ordinary explanations considered."
></textarea>

</section>

<label>
  <input
  type="checkbox"
  required>
  I confirm this report is submitted
  truthfully to the best of my knowledge.
</label>


<label>
  <input
  type="checkbox"
  required>
  I give consent for "The Order of the Lion's Bell" to use and publishes this information if proven meaningful.
</label>




    <button class="submit-btn">
      RECORD TESTIMONY
    </button>

  </form>

</div>


</body>
</html>