<!DOCTYPE html><html lang="en"><head>
  <title>Order of the Lion's Bell</title>
  
  <%- include("partials/metadata") %>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/wheel.css">
</head> <body>
  <%- include("partials/header") %>




<main>
  <section class="hero home">

        <div class="hero-content">
      <h1>The Order of the <br> Lion's Bell</h1>
      </div>


      <a href="#disciplines">
    <div class="hero-media">

      <div class="img-wrap">
  <img src="/images/background.jpg" alt="">
  <div class="img-shield"></div>

          <video
            autoplay
            muted
            loop
            playsinline
            poster="/images/image.jpg"
            class="hero-video"
          >
            <source src="/images/video2.webm" type="video/webm">
          </video>
        </div>
</div>
    <p class="motto">Campana sonat omnibus</p>

</a>
  </section>

  <div id="disciplines">.</div>


<section class="disciplines-center">
  <h2>The Seven Disciplines</h2>
  <div class="disc-circle">
    <div class="center-symbol">✶</div>
    <a href="/philosophia" class="disc d1">Philosophia</a>
    <a href="scientia" class="disc d2">Scientia</a>
    <a href="/traditio" class="disc d3">Traditio</a>
    <a href="/conscientia" class="disc d4">Conscientia</a>
    <a href="/cultura" class="disc d5">Cultura</a>
    <a href="/phenomena" class="disc d6">Phenomena</a>
    <a href="/information" class="disc d7">Information</a>
  </div>
</section>





  
<section class="inner-chamber-preview" id="content">
  <div class="inner-chamber-mark" aria-hidden="true">✦</div>

  <p class="inner-chamber-kicker">THE INWARD TRADITION</p>
  <h2>INNER CHAMBER</h2>

  <div class="inner-chamber-rule"></div>

  <p class="inner-chamber-copy">
    The Inner Chamber preserves the protected philosophical and symbolic
    tradition of the Order — its doctrine, virtues, Lekistra, contemplative
    study and advanced formation.
  </p>

  <div class="inner-chamber-status">
    <div>
      <span>IDENTITY</span>
      <strong><%= (typeof user !== 'undefined' && user) ? 'RECOGNIZED' : 'NOT ESTABLISHED' %></strong>
    </div>

    <div>
      <span>ACCESS</span>
      <strong><%= (typeof user !== 'undefined' && user) ? 'DETERMINED BY HRS' : 'IDENTIFICATION REQUIRED' %></strong>
    </div>

    <div>
      <span>CHAMBER</span>
      <strong>RESTRICTED</strong>
    </div>
  </div>

  <p class="inner-chamber-note">
    Research remains distinct from the inward tradition.
    Access to the Chamber follows formation and institutional permissions.
  </p>

  <% if (typeof user !== 'undefined' && user) { %>
    <a class="inner-chamber-enter" href="/hrs/open">
      ENTER THROUGH HRS <span>&rsaquo;</span>
    </a>
  <% } else { %>
    <a class="inner-chamber-enter" href="/login?next=%2Fhrs">
      IDENTIFY YOURSELF <span>&rsaquo;</span>
    </a>

    <a class="inner-chamber-secondary" href="/register">
      SEEK MEMBERSHIP
    </a>
  <% } %>
</section>












</main>











  <%- include("partials/footer") %>
