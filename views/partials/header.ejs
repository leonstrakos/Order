<header id="header">

  <nav class="nav-left">
    <a
      href="/archive"
      class="<%= currentPath === '/archive' || currentPath.startsWith('/archive/') ? 'active' : '' %>"
    >
      Archive
    </a>

    <a
      href="/about"
      class="<%= currentPath === '/about' ? 'active' : '' %>"
    >
      About
    </a>
  </nav>


  <div class="logo-wrap">
    <a href="/home" aria-label="Order of the Lion's Bell">
      <img
        class="logo-img"
        src="/images/logo-4-stars.webp"
        alt="Order of the Lion's Bell"
      >
    </a>
  </div>


  <nav class="nav-right">

    <a
      href="<%= user ? '/hrs/open' : '/hrs' %>"
      class="nav-box <%= currentPath === '/hrs' || currentPath.startsWith('/hrs/') ? 'active' : '' %>"
    >
      HRS
    </a>

    <% if (user) { %>

      <a
        href="/profile"
        class="nav-box <%= currentPath === '/profile' ? 'active' : '' %>"
      >
        PROFILE
      </a>

    <% } else { %>

      <a
        href="/login"
        class="nav-box <%= currentPath === '/login' ? 'active' : '' %>"
      >
        LOGIN
      </a>

    <% } %>

  </nav>

</header>