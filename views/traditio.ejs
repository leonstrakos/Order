              </div>

              <div class="record-block">
                <h4>Essays</h4>
                <p>On the Fragility of Historical Continuity</p>
              </div>

              <div class="record-block">
                <h4>Correspondence</h4>
                <p>No correspondence has yet been preserved in this section.</p>
              </div>
            </div>
          </div>
        </details>

      </div>
    </section>
