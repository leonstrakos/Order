PORT=3000
NODE_ENV=production
SESSION_SECRET=CHANGE_ME
RESEND_API_KEY=CHANGE_ME

# Public website bridge to the same PostgreSQL bell database used by HRS.
# Use the restricted heralds_web role described in docs/HRS_WEB_BRIDGE_v0.9.md.
HRS_DB_URL=postgresql://heralds_web:CHANGE_ME@127.0.0.1:5432/bell

# HRS identity bridge (same accounts as the mobile app)
HRS_API_URL=http://127.0.0.1:8080
# Set this to the canonical HRS XLSX import endpoint when enabled by the backend.
HRS_HRL_IMPORT_PATH=/api/archive/import/xlsx
